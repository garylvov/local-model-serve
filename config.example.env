# Site settings for local-model-serve. Copy to config.env (gitignored) and edit.
# Everything is optional: with nothing set, a machine serves on :8080 and joins no gateway.

# Public URL of the gateway (what clients and off-network machines use).
LLM_PUBLIC_URL=https://llm.example.com

# Gateway host on the private network. On Slurm, a login node, so the gateway outlives jobs.
# Machines that can resolve this name register directly instead of via LLM_PUBLIC_URL.
LLM_GATEWAY_HOST=

# Cloudflare zone for scripts/cf-route.sh and scripts/cf-machine.sh.
CF_ZONE=example.com
CF_API_TOKEN_FILE=~/.config/local-model-serve/cloudflare-api-token

# Optional: a tunnel token owned by another service on this machine. `llm tunnel` refuses to reuse it.
LLM_FOREIGN_TUNNEL_TOKEN=
